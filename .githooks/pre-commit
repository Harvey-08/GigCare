#!/bin/bash

echo "[CHECK] Running pre-commit checks..."

# Check if we're in the API directory
if [ -f "services/api/package.json" ]; then
    echo "[INFO] Checking API service..."

    cd services/api

    # Run linting
    if npm run lint > /dev/null 2>&1; then
        echo "[PASS] Linting passed"
    else
        echo "[FAIL] Linting failed. Run 'npm run lint:fix' to fix issues."
        exit 1
    fi

    # Run formatting check
    if npm run format:check > /dev/null 2>&1; then
        echo "[PASS] Formatting check passed"
    else
        echo "[FAIL] Formatting check failed. Run 'npm run format' to fix."
        exit 1
    fi

    # Run tests
    if npm test > /dev/null 2>&1; then
        echo "[PASS] Tests passed"
    else
        echo "[FAIL] Tests failed. Fix tests before committing."
        exit 1
    fi

    cd ..
fi

echo "[SUCCESS] All pre-commit checks passed!"